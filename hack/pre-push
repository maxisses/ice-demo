#!/usr/bin/env bash
#
# Tells the Tekton EventListener that a push just happened.
# Installed by hack/setup-pipeline-trigger.sh - do not edit .git/hooks directly.
set -uo pipefail

WEBHOOK_URL="${ICE_DEMO_WEBHOOK_URL:-}"
SECRET="${ICE_DEMO_WEBHOOK_SECRET:-}"

if [ -z "${WEBHOOK_URL}" ] || [ -z "${SECRET}" ]; then
  echo "pre-push: no webhook config, not starting a pipeline" >&2
  exit 0
fi

BRANCH="$(git rev-parse --abbrev-ref HEAD)"
if [ "${BRANCH}" != "main" ]; then
  echo "pre-push: on '${BRANCH}', the pipeline only runs for main" >&2
  exit 0
fi

SHA="$(git rev-parse HEAD)"
MESSAGE="$(git log -1 --pretty=%s | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read().strip()))')"
CLONE_URL="https://github.com/maxisses/ice-demo.git"

# The same shape GitHub puts on the wire for a push event.
PAYLOAD="{\"ref\":\"refs/heads/main\",\"after\":\"${SHA}\",\"head_commit\":{\"id\":\"${SHA}\",\"message\":${MESSAGE}},\"repository\":{\"clone_url\":\"${CLONE_URL}\",\"full_name\":\"maxisses/ice-demo\"}}"

SIGNATURE="sha256=$(printf '%s' "${PAYLOAD}" \
  | openssl dgst -sha256 -hmac "${SECRET}" -r | cut -d' ' -f1)"

echo "pre-push: starting the pipeline for ${SHA:0:7}"

# git has not pushed yet at this point, and the pipeline clones from the
# remote - so give the push a few seconds to land first.
(
  sleep 6
  curl -sS -X POST "${WEBHOOK_URL}" \
    -H "Content-Type: application/json" \
    -H "X-GitHub-Event: push" \
    -H "X-GitHub-Delivery: $(cat /proc/sys/kernel/random/uuid 2>/dev/null || date +%s)" \
    -H "X-Hub-Signature-256: ${SIGNATURE}" \
    -d "${PAYLOAD}" >/dev/null 2>&1 || true
) >/dev/null 2>&1 &
disown 2>/dev/null || true

exit 0
